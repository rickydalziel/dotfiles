#!/bin/bash

SESSION_NAME="float_dev"
DEV_SESSION_NAME="float_work"

cd ~/code/Float

# Check if tmux session already exists
tmux has-session -t $SESSION_NAME 2>/dev/null

if [ $? != 0 ]; then
    # Create new tmux session for services
    tmux new-session -d -s $SESSION_NAME

    # Bring up the devcontainer, clear a stale Rails server pid left over from an
    # unclean shutdown, then start the dev env inside the container. Chained with
    # && in a single send-keys call so bash enforces the ordering itself, rather
    # than relying on tmux to send each command only after the previous one
    # finishes (it doesn't wait, so separate send-keys calls can race).
    tmux send-keys -t $SESSION_NAME:1.1 "devcontainer up --workspace-folder ~/code/Float && devcontainer exec --workspace-folder ~/code/Float bash -c 'test -f tmp/pids/server.pid && ! kill -0 \$(cat tmp/pids/server.pid) 2>/dev/null && rm -f tmp/pids/server.pid; true' && devcontainer exec --workspace-folder ~/code/Float ./start_dev" C-m

    echo "Created tmux session '$SESSION_NAME' for services"
else
    echo "Tmux session '$SESSION_NAME' already exists"
fi

# Check if development session already exists
tmux has-session -t $DEV_SESSION_NAME 2>/dev/null

if [ $? != 0 ]; then
    # Create new tmux session for development work
    tmux new-session -d -s $DEV_SESSION_NAME

    tmux send-keys -t $DEV_SESSION_NAME:1.1 "v" C-m

    tmux new-window -t $DEV_SESSION_NAME
    echo "Created tmux session '$DEV_SESSION_NAME' for development work"
else
    echo "Tmux session '$DEV_SESSION_NAME' already exists"
fi

# Attach to development session
tmux attach-session -t $DEV_SESSION_NAME
